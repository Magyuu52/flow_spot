<div role="tabpanel" class="col-lg-9 tab-pane fade" id="table-2">
  <p>いいねした投稿数: <%= user_liked_posts_count %>件</p>
  <% user_liked_posts.each do |like| %>
    <% post = Post.find_by(id: like.post_id) %>
    <% likes_count = Like.where(post_id: post.id).count %>
    <div class="table-item"
         data-controller="like"
         data-like-url-value="<%= post_likes_path(post.id) %>"
         data-like-liked-value="<%= !!current_user && post.liked?(current_user) %>"
         data-like-count-value="<%= post.likes_count %>"
         data-like-signed-in-value="<%= !!current_user %>">
      <div class="d-flex mb-2 align-items-center">
        <%= link_to user_path(post.user) do %>
          <% if post.user.image.attached? %>
            <%= image_tag(rails_blob_path(post.user.image),:size => "40x40",class:"rounded-circle") %>
          <% else %>
            <%= image_tag("default_user.png", :size => "40x40") %>
          <% end %>
        <% end %>
        <div class="ms-3 post-items-top">
          <%= link_to user_path(post.user) do %>
            <p><%= post.user.name %></p>
          <% end %>
          <p><%= post.address %></p>
        </div>
      </div>
      <div class="row">
        <div class="col-md-2">
          <time><%= l post.created_at, format: :long %></time>
        </div>
        <div class="post-image-large mb-3">
          <% if post.spot_image.attached? %>
            <%= image_tag(rails_blob_path(post.spot_image), class:"img-fluid") %>
          <% else %>
            <%= image_tag("default_spot.jpg", class:"img-fluid") %>
          <% end %>
        </div>
        <div class="col-md-10">
          <div class="post-image-small">
            <% if post.spot_image.attached? %>
              <%= image_tag(rails_blob_path(post.spot_image), class:"img-fluid") %>
            <% else %>
              <%= image_tag("default_spot.jpg", class:"img-fluid") %>
            <% end %>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <div class="contents-area">
              <h4><%= post.title %></h4>
              <a href="#" data-action="click->like#toggle">
                <div class="align-items-center d-flex<%= ' not-liked' unless current_user && post.liked?(current_user) %>" data-like-target="icon">
                  <span class="fa fa-thumbs-up fa-lg"></span>
                  <p class="ms-2 fs-4" data-like-target="count"><%= post.likes_count %></p>
                </div>
              </a>
            </div>
            <div class="btn-area-large text-center">
              <a href="#" data-action="click->like#toggle"
                 data-like-target="buttonText"
                 class="<%= current_user && post.liked?(current_user) ? 'btn-1' : 'btn-2' %> text-center">
                <%= current_user && post.liked?(current_user) ? "いいね済み" : "いいねする" %>
              </a>
              <%= link_to "スポット詳細へ", post_path(post), class:"btn-1 mt-1" %>
            </div>
          </div>
        </div>
        <div class="btn-area-small text-center">
          <a href="#" data-action="click->like#toggle"
             data-like-target="buttonText"
             class="<%= current_user && post.liked?(current_user) ? 'btn-1' : 'btn-2' %> text-center">
            <%= current_user && post.liked?(current_user) ? "いいね済み" : "いいねする" %>
          </a>
          <%= link_to "スポット詳細へ", post_path(post), class:"btn-1 ms-1" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
