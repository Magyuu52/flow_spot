<section id="search-form">
  <div class="container aos-init aos-animate" data-aos="zoom-in">
    <%= search_form_for(@q, url: search_posts_path, method: :get) do |f| %>
      <div class="d-flex align-items-center justify-content-center mb-3">
        <%= f.search_field :title_or_address_or_user_name_cont, placeholder: "投稿者、タイトル、住所" %>
        <%= f.submit "検索" %>
      </div>
      <div class="d-flex align-items-center justify-content-center flex-wrap gap-2">
        <%= f.search_field :address_cont, placeholder: "住所で絞り込み", style: "min-width: auto; max-width: 200px;" %>
        <%= f.date_field :created_at_gteq, style: "min-width: auto; max-width: 155px;", title: "この日以降" %>
        <span style="color: #9195a2; font-size: 14px;">〜</span>
        <%= f.date_field :created_at_lteq, style: "min-width: auto; max-width: 155px;", title: "この日まで" %>
      </div>
    <% end %>
  </div>
</section>
